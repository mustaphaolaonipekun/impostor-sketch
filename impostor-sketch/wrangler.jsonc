{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "impostor-sketch",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-04",
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOM",
        "class_name": "GameRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MyDurableObject"]
    },
    {
      "tag": "v2",
      "renamed_classes": [
        {
          "from": "MyDurableObject",
          "to": "GameRoom"
        }
      ]
    }
  ]
}